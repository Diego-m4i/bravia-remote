{
  "name": "pairbeam",
  "version": "1.0.0",
  "private": true,
  "description": "App desktop unica per il telecomando Sony Bravia: avvia relay e agent e apre subito il telecomando.",
  "author": "Diego Marinangeli",
  "main": "main.js",
  "scripts": {
    "copy-shared": "node scripts/copy-shared.js",
    "start": "npm run copy-shared && electron .",
    "dist": "npm run copy-shared && electron-builder --win nsis"
  },
  "dependencies": {
    "node-ssdp": "^4.0.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "rcedit": "^5.0.2"
  },
  "build": {
    "appId": "com.diegomarinangeli.pairbeam",
    "productName": "PairBeam",
    "files": [
      "main.js",
      "build/**/*",
      "assets/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist-electron"
    },
    "artifactName": "PairBeam-Setup.exe",
    "afterPack": "./scripts/after-pack.js",
    "win": {
      "target": "nsis",
      "signAndEditExecutable": false,
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "allowScripts": {
    "electron@31.7.7": true
  }
}
